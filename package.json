{
  "name": "praxisjona-website",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "contentlayer dev & next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "next-sitemap && npm run seo:submit-recrawl",
    "seo:submit-recrawl": "node scripts/seo/submit-recrawl.mjs",
    "seo:audit-priority": "node scripts/seo/priority-indexability.mjs",
    "seo:test-priority": "node --test tests/seo/priority-indexability.node-test.mjs",
    "gen-sitemap": "next-sitemap",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run seo:test-priority && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run build && npm run test && npm run test:e2e",
    "gsc:fetch": "node scripts/gsc/fetch-search-analytics.mjs",
    "gsc:dashboard": "node scripts/gsc/build-dashboard.mjs",
    "gsc:title-tests": "node scripts/gsc/export-title-test-candidates.mjs",
    "gsc:recommendations": "node scripts/gsc/build-recommendations.mjs",
    "gsc:snapshot": "node scripts/gsc/build-dashboard-snapshot.mjs",
    "gsc:weekly": "node scripts/gsc/run-weekly.mjs",
    "gsc:daily": "npm run gsc:weekly",
    "gsc:record-implementation": "node scripts/gsc/record-implementation.mjs",
    "gsc:compare": "node scripts/gsc/compare-baseline.mjs",
    "umami:fetch": "node scripts/umami/fetch-growth-analytics.mjs",
    "growth:collect": "npm run gsc:weekly && npm run umami:fetch"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^2.0.16",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@sendgrid/mail": "^8.1.3",
    "@types/node": "22.16.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^0.1.11",
    "@vercel/edge-config": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^1.2.1",
    "contentlayer": "0.3.1",
    "date-fns": "^2.29.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.1",
    "framer-motion": "^12.38.0",
    "headlessui": "^0.0.0",
    "jspdf": "^3.0.3",
    "lucide-react": "^1.17.0",
    "mdast-util-toc": "^7.0.0",
    "next": "16.4.1",
    "next-contentlayer": "0.3.1",
    "next-sitemap": "^4.0.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.78.0",
    "react-hot-toast": "^2.4.0",
    "react-icons": "^5.4.0",
    "react-lite-youtube-embed": "^2.3.52",
    "react-markdown": "^9.0.1",
    "rehype-autolink-headings": "^7.0.0",
    "rehype-pretty-code": "^0.10.1",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^3.0.1",
    "sharp": "^0.35.5",
    "signature_pad": "^5.1.1",
    "tailwind-merge": "^1.10.0",
    "turndown": "^7.2.4",
    "typescript": "5.0.2",
    "vercel": "^32.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/signature_pad": "^2.3.6",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.14",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.4.1",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@headlessui/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@testing-library/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@vercel/analytics": {
      "react": "$react"
    },
    "next-contentlayer": {
      "next": "$next"
    }
  }
}
